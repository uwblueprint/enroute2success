# typescript-eslint 8 declares a peer range of typescript <6.1.0. We pin
# typescript 6.0.x so linting works, but npm still needs this to resolve the
# tree without erroring. Remove once typescript-eslint supports TS >=7.1
# (https://github.com/typescript-eslint/typescript-eslint/issues/10940).
legacy-peer-deps=true
