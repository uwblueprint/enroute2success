// Docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum session_type {
  golf
  chess
}

enum session_status {
  draft
  scheduled
  cancelled
}

model session {
  id               String         @id @default(uuid()) @db.Uuid
  session_series_id String?        @db.Uuid
  name             String
  description      String?
  location         String?
  max_attendees    Int?
  status           session_status @default(draft)
  session_type     session_type
  start_datetime   DateTime       @db.Timestamp(6)
  end_datetime     DateTime       @db.Timestamp(6)
  notes            String?
  image_urls       String[]
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  updated_at       DateTime       @default(now()) @db.Timestamp(6)

  session_series session_series? @relation(fields: [session_series_id], references: [id])

  @@index([start_datetime])
  @@map("session")
}

model session_series {
  id            String       @id @default(uuid()) @db.Uuid
  recurrence    String
  name          String
  description   String?
  location      String?
  max_attendees Int?
  session_type  session_type
  start_date    DateTime     @db.Date
  end_date      DateTime?    @db.Date
  start_time    DateTime     @db.Time(6)
  end_time      DateTime     @db.Time(6)
  image_urls    String[]
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)

  sessions session[]

  @@map("session_series")
}
