// Docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum StaffType {
  ADMIN @map("admin")
  COACH @map("coach")
  VOLUNTEER @map("volunteer")

  @@map("staff_type")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  first_name String
  last_name String
  preferred_name String?
  email String @unique
  phone_number String
  password_hash String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt 

  // A user may or may not have a staff record.
  staff StaffUsers?

  refreshTokens refresh_tokens[]

  @@map("users")
}

model StaffUsers {
  // Shared PK with User — must be the same UUID, so no @default(uuid()).
  id String @id @db.Uuid
  staffType StaffType @map("type")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt 

  @@map("staff_users")
}

model refresh_tokens {
  id String @id @default(uuid()) @db.Uuid
  user_id String @db.Uuid
  token_hash String @unique @db.VarChar
  expires_at DateTime  @db.Timestamp(3)
  revoked_at DateTime? @db.Timestamp(3)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt 

  user User @relation(fields: [user_id], references: [id])
}
