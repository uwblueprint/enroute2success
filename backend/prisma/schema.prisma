// Docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum StaffType {
  ADMIN @map("admin")
  COACHES @map("coaches")
  VOLUNTEER @map("volunteer")

  @@map("staff_type")
}

model User {
  id String @id @db.Uuid
  first_name String @map("first_name")
  last_name String @map("last_name")
  preferred_name String? @map("preferred_name") // Optional
  email String @unique
  phone_number String @map("phone_number")
  password_hash String @map("password_hash")

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt 

  // A user may or may not have a staff record.
  staff StaffUsers?

  refreshTokens refresh_tokens[]

  @@map("users")
}

model StaffUsers {
  id String @id @db.Uuid
  staffType StaffType @map("type")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt 

  @@map("staff_users")
}

model refresh_tokens {
  id String @id @db.Uuid
  user_id String @db.Uuid
  token_hash String @unique @db.VarChar
  expires_at DateTime  @db.Timestamp(3)
  revoked_at DateTime? @db.Timestamp(3)
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt 

  user User @relation(fields: [user_id], references: [id])
}
