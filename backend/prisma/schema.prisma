// Docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum session_type {
  golf
  chess
}

enum session_status {
  draft
  scheduled
  cancelled
}

enum Role {
  ADMIN     @map("admin")
  COACH     @map("coach")
  VOLUNTEER @map("volunteer")
  STUDENT   @map("student")

  @@map("role")
}

model session {
  id                String         @id @default(uuid()) @db.Uuid
  session_series_id String?        @db.Uuid
  name              String
  description       String?
  location          String?
  max_attendees     Int?
  status            session_status @default(draft)
  session_type      session_type
  start_datetime    DateTime       @db.Timestamp(6)
  end_datetime      DateTime       @db.Timestamp(6)
  notes             String?
  image_urls        String[]
  created_at        DateTime       @default(now()) @db.Timestamp(6)
  updated_at        DateTime       @default(now()) @db.Timestamp(6)

  session_series session_series? @relation(fields: [session_series_id], references: [id])
  feedback       Feedback[]
  session_points SessionPoints[]

  @@index([start_datetime])
  @@map("session")
}

model session_series {
  id            String       @id @default(uuid()) @db.Uuid
  recurrence    String
  name          String
  description   String?
  location      String?
  max_attendees Int?
  session_type  session_type
  start_date    DateTime     @db.Date
  end_date      DateTime?    @db.Date
  start_time    DateTime     @db.Time(6)
  end_time      DateTime     @db.Time(6)
  image_urls    String[]
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)

  sessions session[]

  @@map("session_series")
}

model User {
  id             String  @id @default(uuid()) @db.Uuid
  first_name     String
  last_name      String
  preferred_name String?
  email          String  @unique
  phone_number   String
  password_hash  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // A user may or may not have a staff record.
  staff StaffUsers?

  refreshTokens      refresh_tokens[]
  announcements      Announcements[]
  students           Student[]
  accountSetupTokens AccountSetupToken[]

  @@map("users")
}

model Student {
  membership_id  Int      @id
  manager_id     String?  @db.Uuid
  first_name     String   @db.VarChar
  last_name      String?  @db.VarChar
  preferred_name String?  @db.VarChar
  points         Int      @default(0)
  allergies      String[] @db.VarChar
  notes          String?  @db.VarChar
  birth_date     DateTime @db.Date
  created_at     DateTime @default(now()) @db.Timestamp(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamp(6)

  manager            User?               @relation(fields: [manager_id], references: [id], onDelete: SetNull)
  accountSetupTokens AccountSetupToken[]
  feedback           Feedback[]
  session_points     SessionPoints[]

  @@index([manager_id])
  @@map("students")
}

model AccountSetupToken {
  id            String    @id @default(uuid()) @db.Uuid
  email         String
  membership_id Int
  user_id       String?   @db.Uuid
  token_hash    String    @unique @db.VarChar
  expires_at    DateTime  @db.Timestamp(3)
  used_at       DateTime? @db.Timestamp(3)
  created_at    DateTime  @default(now()) @db.Timestamp(3)

  student Student @relation(fields: [membership_id], references: [membership_id], onDelete: Cascade)
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([membership_id])
  @@index([user_id])
  @@map("account_setup_tokens")
}

model StaffUsers {
  id   String @id @db.Uuid
  role Role   @map("type")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  feedback_given   Feedback[] @relation("FeedbackGiver")
  feedback_updated Feedback[] @relation("FeedbackUpdater")

  session_points_given   SessionPoints[] @relation("SessionPointsGiver")
  session_points_updated SessionPoints[] @relation("SessionPointsUpdater")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("staff_users")
}

model Feedback {
  id         String   @id @default(uuid()) @db.Uuid
  receiver   Int
  giver      String   @db.Uuid
  updated_by String   @db.Uuid
  session_id String   @db.Uuid
  text       String
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  student Student    @relation(fields: [receiver], references: [membership_id])
  author  StaffUsers @relation("FeedbackGiver", fields: [giver], references: [id])
  updater StaffUsers @relation("FeedbackUpdater", fields: [updated_by], references: [id])
  session session    @relation(fields: [session_id], references: [id], onDelete: Restrict)

  @@unique([receiver, session_id])
  @@index([session_id])
  @@index([receiver])
  @@map("feedback_log")
}

model SessionPoints {
  id                String   @id @default(uuid()) @db.Uuid
  session_id        String   @db.Uuid
  membership_id     Int
  attendance        Int      @default(0)
  punctuality       Int      @default(0)
  teamwork          Int      @default(0)
  focus             Int      @default(0)
  discipline        Int      @default(0)
  respect           Int      @default(0)
  sportsmanship     Int      @default(0)
  extra_recognition Int      @default(0)
  attended_workshop Int      @default(0)
  won_tournament    Int      @default(0)
  given_by          String   @db.Uuid
  updated_by        String   @db.Uuid
  created_at        DateTime @default(now()) @db.Timestamp(6)
  updated_at        DateTime @updatedAt @db.Timestamp(6)

  session session    @relation(fields: [session_id], references: [id], onDelete: Restrict)
  student Student    @relation(fields: [membership_id], references: [membership_id], onDelete: Cascade)
  author  StaffUsers @relation("SessionPointsGiver", fields: [given_by], references: [id])
  updater StaffUsers @relation("SessionPointsUpdater", fields: [updated_by], references: [id])

  @@unique([session_id, membership_id])
  @@index([session_id])
  @@index([membership_id])
  @@map("session_points")
}

model refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar
  expires_at DateTime  @db.Timestamp(3)
  revoked_at DateTime? @db.Timestamp(3)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model Announcements {
  id         String    @id @default(uuid()) @db.Uuid
  message    String
  start_date DateTime
  end_date   DateTime
  deleted_at DateTime?
  created_by String    @db.Uuid
  created_at DateTime  @default(now()) @map("createdAt")
  updated_at DateTime  @updatedAt @map("updatedAt")

  creator User @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([end_date])
  @@map("announcements")
}
