// Docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

enum session_type {
  golf
  chess
}

enum session_status {
  draft
  scheduled
  cancelled
}

enum StaffType {
  ADMIN     @map("admin")
  COACH     @map("coach")
  VOLUNTEER @map("volunteer")

  @@map("staff_type")
}

model session {
  id                String         @id @default(uuid()) @db.Uuid
  session_series_id String?        @db.Uuid
  name              String
  description       String?
  location          String?
  max_attendees     Int?
  status            session_status @default(draft)
  session_type      session_type
  start_datetime    DateTime       @db.Timestamp(6)
  end_datetime      DateTime       @db.Timestamp(6)
  notes             String?
  image_urls        String[]
  created_at        DateTime       @default(now()) @db.Timestamp(6)
  updated_at        DateTime       @default(now()) @db.Timestamp(6)

  session_series session_series? @relation(fields: [session_series_id], references: [id])

  @@index([start_datetime])
  @@map("session")
}

model session_series {
  id            String       @id @default(uuid()) @db.Uuid
  recurrence    String
  name          String
  description   String?
  location      String?
  max_attendees Int?
  session_type  session_type
  start_date    DateTime     @db.Date
  end_date      DateTime?    @db.Date
  start_time    DateTime     @db.Time(6)
  end_time      DateTime     @db.Time(6)
  image_urls    String[]
  created_at    DateTime     @default(now()) @db.Timestamp(6)
  updated_at    DateTime     @default(now()) @db.Timestamp(6)

  sessions session[]

  @@map("session_series")
}

model User {
  id             String  @id @default(uuid()) @db.Uuid
  first_name     String
  last_name      String
  preferred_name String?
  email          String  @unique
  phone_number   String
  password_hash  String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // A user may or may not have a staff record.
  staff StaffUsers?

  refreshTokens refresh_tokens[]
  announcements Announcements[]

  @@map("users")
}

model StaffUsers {
  id        String    @id @db.Uuid
  staffType StaffType @map("type")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("staff_users")
}

model refresh_tokens {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar
  expires_at DateTime  @db.Timestamp(3)
  revoked_at DateTime? @db.Timestamp(3)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id])
}

model Announcements {
  id         String    @id @default(uuid()) @db.Uuid
  message    String
  start_date DateTime
  end_date   DateTime?
  deleted_at DateTime?
  created_by String    @db.Uuid
  created_at DateTime  @default(now()) @map("createdAt")
  updated_at DateTime  @updatedAt @map("updatedAt")

  creator User @relation(fields: [created_by], references: [id], onDelete: Cascade)

  @@index([created_by])
  @@map("announcements")
}
